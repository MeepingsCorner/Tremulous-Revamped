[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]
linux.debug.x86_64 = "res://bin/libtrem_godot.so"
linux.release.x86_64 = "res://bin/libtrem_godot.so"
windows.debug.x86_64 = "res://bin/trem_godot.dll"
windows.release.x86_64 = "res://bin/trem_godot.dll"
macos.debug = "res://bin/libtrem_godot.dylib"
macos.release = "res://bin/libtrem_godot.dylib"

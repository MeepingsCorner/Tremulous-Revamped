+fn is_ident_char(c: char) -> bool {
+    c == '_' || c.is_alphanumeric()
+}
+
+/// `s[i]` is a `'` that opens a Rust lifetime or label rather than a char
+/// literal: an identifier follows and is not closed by another `'`.
+/// `'a'`, `'\n'` and C multi-character constants like `'RIFF'` stay literals.
+fn is_lifetime(s: &[char], i: usize) -> bool {
+    let n = s.len();
+    let first = if i + 1 < n { s[i + 1] } else { return false };
+    if !(first == '_' || first.is_alphabetic()) {
+        return false;
+    }
+    let mut j = i + 1;
+    while j < n && is_ident_char(s[j]) {
+        j += 1;
+    }
+    !(j < n && s[j] == '\'')
+}
+
+/// `s[i]` is the opening `"` of a Rust raw string; returns its `#` count.
+/// The prefix must be `r` or `br` that does not end a longer identifier.
+fn raw_string_hashes(s: &[char], i: usize) -> Option<usize> {
+    let mut j = i;
+    let mut hashes = 0;
+    while j > 0 && s[j - 1] == '#' {
+        j -= 1;
+        hashes += 1;
+    }
+    if j == 0 || s[j - 1] != 'r' {
+        return None;
+    }
+    j -= 1;
+    if j > 0 && s[j - 1] == 'b' {
+        j -= 1;
+    }
+    if j > 0 && is_ident_char(s[j - 1]) {
+        return None;
+    }
+    Some(hashes)
+}
+
